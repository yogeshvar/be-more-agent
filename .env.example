# llama-server OpenAI-compatible base URL (include /v1)
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=gpt-3.5-turbo
LLAMA_API_KEY=not-needed

ASSISTANT_NAME=Beemboy
TEMPERATURE=0.7
MAX_TOOL_ROUNDS=16
REQUEST_TIMEOUT_S=120

# Brave Search MCP (stdio via npx). Enables web search tools when set.
BRAVE_API_KEY=
BRAVE_MCP_ENABLED=true
# Space-separated args after npx (override if needed)
# BRAVE_NPX_ARGS=-y @modelcontextprotocol/server-brave-search

# Optional extra MCP servers as JSON array:
# [{"id":"files","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"],"env":{}}]
# {"id":"remote","transport":"http","url":"http://127.0.0.1:8000/mcp"}
MCP_SERVERS=

# Session system-prompt context (no Brave required)
LIVE_CONTEXT_ENABLED=true
WEATHER_CITY=
WEATHER_LAT=
WEATHER_LON=
OPENWEATHERMAP_API_KEY=
WEATHER_UNITS=metric
NEWSAPI_KEY=
NEWS_COUNTRY=us
NEWS_RSS_URLS=
