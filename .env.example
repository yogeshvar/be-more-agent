# Deprecated: settings now live in config/settings.json
# llama-server OpenAI-compatible base URL (include /v1)
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=gpt-3.5-turbo
LLAMA_API_KEY=not-needed

ASSISTANT_NAME=Beemboy
TEMPERATURE=0.7
MAX_TOOL_ROUNDS=16
REQUEST_TIMEOUT_S=120
# Stream assistant tokens to the terminal (OpenAI-compatible SSE). Set false if llama-server errors.
STREAM_RESPONSES=true
# Durable local memory file (JSON)
MEMORY_STORE_PATH=.beemboy_memory.json
# Optional: disable internal context compression if needed
CONTEXT_COMPRESSION=true

# Camera identity (offline-first; embeddings-only registry)
CAMERA_ENABLED=false
# JSON file for enrolled face embeddings + identity metadata
CAMERA_IDENTITY_STORE_PATH=.beemboy_identities.json
# Cosine similarity threshold for known match
CAMERA_MATCH_THRESHOLD=0.82
# Prompt used when an unknown face is detected
CAMERA_UNKNOWN_PROMPT=I don't recognize you yet. What's your name?
# Face detection backend: opencv or none
CAMERA_DETECTOR_BACKEND=opencv
# Minimum face size for OpenCV detector
CAMERA_MIN_FACE_SIZE_PX=80

# Desktop UI (Tkinter)
# Assets path used for app icon/background/thumbnails
UI_ASSETS_PATH=assets
# Camera poll interval for preview/recognition updates
UI_POLL_INTERVAL_MS=120

# Voice stack (offline-first, Pi-friendly defaults)
# Requires: ONNX wake model, whisper-cli model, piper model.
VOICE_WAKE_MODEL_PATH=assets/wakeword/hey_bmo.onnx
VOICE_WAKE_PHRASE=hey bmo
VOICE_WAKE_THRESHOLD=0.52
VOICE_WHISPER_MODEL_PATH=models/ggml-base.en.bin
VOICE_PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
# VOICE_WHISPER_BINARY=whisper-cli
# VOICE_PIPER_BINARY=piper
VOICE_FOLLOWUP_SECONDS=3.5
# Optional tuning
# VOICE_INPUT_DEVICE=
# VOICE_ENERGY_THRESHOLD=0.015
# VOICE_MAX_UTTERANCE_SECONDS=8.0
# VOICE_SILENCE_SECONDS=0.9
# VOICE_PLAYBACK_COMMAND=aplay

# Brave Search MCP (stdio via npx). Enables web search tools when set.
BRAVE_API_KEY=
BRAVE_MCP_ENABLED=true
# Space-separated args after npx (override if needed)
# BRAVE_NPX_ARGS=-y @modelcontextprotocol/server-brave-search

# Built-in default MCP set when no BRAVE/MCP_PROXY/MCP_SERVERS are configured:
# time, fetch, ddg-search via uvx.
DEFAULT_MCP_ENABLED=true
# Optional timezone for mcp-server-time (example: America/Chicago)
# DEFAULT_TIME_TIMEZONE=

# Optional extra MCP servers as JSON array:
# [{"id":"files","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"],"env":{}}]
# {"id":"remote","transport":"http","url":"http://127.0.0.1:8000/mcp","http_mode":"streamable"}
# http_mode: streamable (default, /mcp) or sse (/sse URLs)
MCP_SERVERS=

# mcp-proxy (same URLs as llama-server Web UI): set base + config path and/or comma-separated names.
# Run: uvx mcp-proxy --named-server-config mcp-config.json --allow-origin "*" --port 8001 --stateless
# MCP_PROXY_BASE_URL=http://127.0.0.1:8001
# MCP_PROXY_CONFIG=/path/to/mcp-config.json
# MCP_PROXY_SERVERS=time,fetch,ddg-search
# MCP_PROXY_URL_SUFFIX=mcp

# Session system-prompt context (no Brave required)
LIVE_CONTEXT_ENABLED=true
WEATHER_CITY=
WEATHER_LAT=
WEATHER_LON=
OPENWEATHERMAP_API_KEY=
WEATHER_UNITS=metric
NEWSAPI_KEY=
NEWS_COUNTRY=us
NEWS_RSS_URLS=
